{
  "name": "action-tailor",
  "version": "1.0.0",
  "description": "Action Tailor - Pakistani Tailoring Shop Management System",
  "main": "index.ts",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend-admin",
    "frontend-customer"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:backend": "npm --prefix backend run dev",
    "dev:admin": "npm --prefix frontend-admin run dev",
    "dev:customer": "npm --prefix frontend-customer run dev",
    "start": "tsx backend/index.ts",
    "build": "npm --prefix frontend-admin run build && npm --prefix frontend-customer run build",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p frontend-admin/tsconfig.json && tsc --noEmit -p frontend-customer/tsconfig.json",
    "seed": "tsx backend/seeds/seed.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chalk": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^6.2.0"
  }
}
