{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["backend/**/*.ts", "shared/**/*.ts", "scripts/**/*.ts", "api/**/*.ts", "index.ts"],
  "exclude": ["node_modules", "frontend-admin", "frontend-customer", "public"]
}
