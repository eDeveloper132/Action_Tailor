# ==============================================================================
# Action Tailor - Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp/
.pnp.js

# Build Outputs & Bundles
dist/
*/dist/
build/
*/build/
out/
.cache/
.turbo/
*.tsbuildinfo

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Logs & Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# IDE & Editor Configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# Testing & Scratch Files
coverage/
scratch/
.system_generated/
.temp/
.tmp/

# Deployment & Hosting
.vercel/
